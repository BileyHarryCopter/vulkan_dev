#version 450
#extension GL_EXT_mesh_shader : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 124) out;

layout(location = 0) out vec3 fragColor[];
layout(location = 1) out vec2 fragTexCoord[];

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 projectionViewMatrix;
    vec3     directionToLight;
} ubo;

layout(push_constant) uniform Push {
    mat4  modelMatrix;
    mat4 normalMatrix;
} push;

const float AMBIENT = 0.02;

// Simple test geometry - a triangle
void main() {
    SetMeshOutputsEXT(3, 1);

    // Generate a simple triangle for testing
    // In a real implementation, this would read from a storage buffer
    // Increased size from -0.5..0.5 to -2.0..2.0 for better visibility
    vec3 positions[3] = vec3[](
        vec3(-2.0, -2.0, 0.0),
        vec3( 2.0, -2.0, 0.0),
        vec3( 0.0,  2.0, 0.0)
    );

    vec3 colors[3] = vec3[](
        vec3(1.0, 0.0, 0.0),
        vec3(0.0, 1.0, 0.0),
        vec3(0.0, 0.0, 1.0)
    );

    vec3 normals[3] = vec3[](
        vec3(0.0, 0.0, 1.0),
        vec3(0.0, 0.0, 1.0),
        vec3(0.0, 0.0, 1.0)
    );

    vec2 uvs[3] = vec2[](
        vec2(0.0, 0.0),
        vec2(1.0, 0.0),
        vec2(0.5, 1.0)
    );

    // Emit vertices
    for (uint i = 0; i < 3; i++) {
        gl_MeshVerticesEXT[i].gl_Position = ubo.projectionViewMatrix * push.modelMatrix * vec4(positions[i], 1.0);
        
        vec3 normalWorldSpace = normalize(mat3(push.normalMatrix) * normals[i]);
        float lightIntensity = AMBIENT + max(dot(normalWorldSpace, ubo.directionToLight), 0);
        
        fragColor[i] = lightIntensity * colors[i];
        fragTexCoord[i] = uvs[i];
    }

    // Emit primitive
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
}

